# Anthropic Claude API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here

# Google Gemini API Key (used when USE_GEMINI=True in scripts/extract_pdf.py)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Server-only exact email allowlist for the question-paper feature.
# Comma-separated addresses. Empty or malformed values fail closed.
QUESTION_PAPER_ALLOWED_EMAILS=

# Server-only trusted browser origins for cookie-authenticated mutations.
# Comma-separated scheme://host[:port] values. Required in production so
# Railway's public HTTPS origin is accepted. Do not put secrets here.
QUESTION_PAPER_TRUSTED_ORIGINS=

# Optional bounded upload overrides. Invalid or unlimited values are ignored.
# QUESTION_PAPER_MAX_UPLOAD_BYTES=   # default 10485760 (10 MiB), hard ceiling 50 MiB
# QUESTION_PAPER_MAX_PDF_PAGES=      # default 20, hard ceiling 100
# QUESTION_PAPER_MAX_DIAGRAM_BYTES=  # default 2097152 (2 MiB), hard ceiling 10 MiB
# QUESTION_PAPER_OCR_TIMEOUT_MS=
# QUESTION_PAPER_PDF_TIMEOUT_MS=
